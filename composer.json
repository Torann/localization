{
  "name": "torann/localization",
  "description": "Simple subdomain localization for Laravel.",
  "keywords": [
    "localization",
    "laravel",
    "locale",
    "subdomain"
  ],
  "license": "BSD-2-Clause",
  "authors": [
    {
      "name": "Daniel Stainback",
      "email": "torann@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/routing": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/http": "^9.0|^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "mockery/mockery": "^1.4.4",
    "phpstan/phpstan": "^1.6",
    "squizlabs/php_codesniffer": "^3.6"
  },
  "autoload": {
    "files": [
      "src/helpers.php"
    ],
    "psr-4": {
      "Torann\\Localization\\": "src/"
    }
  }
}
